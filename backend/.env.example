# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# The application reads these from the environment; application.yml contains no
# credentials. Defaults in application.yml exist so a fresh clone boots against the
# docker-compose database without any setup, and for nothing else.

# --- database -----------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:55432/engineers_day
DB_USERNAME=engineers_day
DB_PASSWORD=engineers_day

# Consumed by docker-compose.yml when it creates the container.
DB_NAME=engineers_day
DB_PORT=55432

# --- application --------------------------------------------------------------
SERVER_PORT=8080
DB_POOL_SIZE=10
LOG_LEVEL=INFO
SHOW_SQL=false

# Origins allowed to call the API. Comma-separated, no wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- tests (Windows + Docker Desktop only) ------------------------------------
# Testcontainers probes npipe:////./pipe/docker_engine. Docker Desktop's active
# context is usually desktop-linux, on a different pipe, so tests report
# "Could not find a valid Docker environment" even though the docker CLI works.
# Check yours with: docker context ls
# DOCKER_HOST=npipe:////./pipe/dockerDesktopLinuxEngine
